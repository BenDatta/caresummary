# Copy to .env and fill in:  cp .env.example .env

# From fhir.epic.com → Build Apps → your app
EPIC_NON_PROD_CLIENT_ID=
EPIC_PROD_CLIENT_ID=

# Must EXACTLY match a Redirect URI registered on your Epic app
REDIRECT_URI=http://localhost:8045
PORT=8045

# Optional: preselect a health system by part of its name
DEFAULT_ORGANIZATION=

# Optional: override the requested scopes
# SCOPE=openid fhirUser launch/patient patient/Patient.read patient/Observation.read patient/MedicationRequest.read
